include(ExternalProject)

set(PICOLIBC_ROOT_DIR    "${CMAKE_SOURCE_DIR}/build/picolibc-m3")
set(PICOLIBC_SOURCE_DIR  "${CMAKE_SOURCE_DIR}/lib/picolibc")
set(PICOLIBC_BINARY_DIR  "${PICOLIBC_ROOT_DIR}/build")
set(PICOLIBC_INSTALL_DIR "${PICOLIBC_ROOT_DIR}/install")
set(PICOLIBC_TOOLCHAIN   "${CMAKE_SOURCE_DIR}/lib/stm32/cmake/picolibc-cortex-m3.cmake")

ExternalProject_Add(picolibc_ext
    PREFIX              "${PICOLIBC_ROOT_DIR}"
    SOURCE_DIR          "${PICOLIBC_SOURCE_DIR}"
    BINARY_DIR          "${PICOLIBC_BINARY_DIR}"
    INSTALL_DIR         "${PICOLIBC_INSTALL_DIR}"
    CMAKE_GENERATOR     "${CMAKE_GENERATOR}"
    CMAKE_ARGS
        -DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}
        -DCMAKE_TOOLCHAIN_FILE=${PICOLIBC_TOOLCHAIN}
        -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
        -DCMAKE_BUILD_TYPE=MinSizeRel
        -DCMAKE_INSTALL_PREFIX=${PICOLIBC_INSTALL_DIR}
        -D__PREFER_SIZE_OVER_SPEED=ON
        -DENABLE_MALLOC=OFF
        -D__SINGLE_THREAD=ON
        -D__THREAD_LOCAL_STORAGE=OFF
        -D__GLOBAL_ERRNO=ON
        -D__IO_DEFAULT=i
        -D__IO_FLOAT=OFF
        -D__IO_C99_FORMATS=ON
        -D__IO_LONG_LONG=OFF
        -DTESTS=OFF
    BUILD_BYPRODUCTS
        "${PICOLIBC_INSTALL_DIR}/lib/libc.a"
    USES_TERMINAL_CONFIGURE TRUE
    USES_TERMINAL_BUILD     TRUE
    USES_TERMINAL_INSTALL   TRUE
)

execute_process(
    COMMAND "${CMAKE_C_COMPILER}" -print-file-name=include
    OUTPUT_VARIABLE GCC_BUILTIN_INCLUDE_DIR
    OUTPUT_STRIP_TRAILING_WHITESPACE
)

execute_process(
    COMMAND "${CMAKE_C_COMPILER}" -print-file-name=include-fixed
    OUTPUT_VARIABLE GCC_FIXED_INCLUDE_DIR
    OUTPUT_STRIP_TRAILING_WHITESPACE
)

file(TO_CMAKE_PATH "${GCC_BUILTIN_INCLUDE_DIR}" GCC_BUILTIN_INCLUDE_DIR)
file(TO_CMAKE_PATH "${GCC_FIXED_INCLUDE_DIR}" GCC_FIXED_INCLUDE_DIR)

string(APPEND CMAKE_C_FLAGS
    " -nostdinc"
    " -isystem \"${PICOLIBC_INSTALL_DIR}/include\""
    " -isystem \"${GCC_BUILTIN_INCLUDE_DIR}\""
    " -isystem \"${GCC_FIXED_INCLUDE_DIR}\""
)
